{
  "name": "primavera-pm-system",
  "version": "1.0.0",
  "description": "Oracle Primavera P6風デスクトップ専用プロジェクト管理システム",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build:electron && electron .",
    "dev": "webpack serve --mode=development",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "webpack --config webpack.main.config.js --mode=production",
    "build:preload": "webpack --config webpack.preload.config.js --mode=production",
    "build:renderer": "webpack --mode=production",
    "build:electron": "npm run build:main && npm run build:preload",
    "package": "electron-builder",
    "test": "jest",
    "dev:electron": "electron-forge start",
    "make": "electron-forge make"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "project-management",
    "gantt",
    "primavera"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-deb": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@types/recharts": "^1.8.29",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "crypto-browserify": "^3.12.1",
    "css-loader": "^7.1.2",
    "electron": "^38.2.0",
    "global": "^4.4.0",
    "html-webpack-plugin": "^5.6.4",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "util": "^0.12.5",
    "wait-on": "^9.0.1",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@mui/x-date-pickers": "^8.12.0",
    "@reduxjs/toolkit": "^2.9.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@types/react-virtualized": "^9.22.3",
    "better-sqlite3": "^12.4.1",
    "date-fns": "^4.1.0",
    "events": "^3.3.0",
    "moment": "^2.30.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.3",
    "react-virtualized": "^9.22.6",
    "recharts": "^3.2.1",
    "typescript": "^5.9.2"
  }
}
